# The production origin, without a trailing slash. For local form tests use http://localhost:3012
SITE_URL=https://todarabia.com
SITE_INDEXABLE=false
# Enable only after approved privacy text is saved and privacyApproved=true in content/site.json.
CONTACT_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Decap GitHub OAuth provider; see docs/CMS.md. Never put client secrets in public config.
CMS_ENABLED=false
CMS_REPO=ahmedsamyabdellattif/TOD-
CMS_BRANCH=main
CMS_AUTH_URL=
CMS_AUTH_ENDPOINT=auth
